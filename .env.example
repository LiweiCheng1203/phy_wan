# Copy to .env and source it from the repository root. .env is not committed.
export SIM2REAL_ROOT="$PWD"
export SIM2REAL_REPO="$(dirname "$PWD")/VideoX-Fun"
export SIM2REAL_MODEL="$SIM2REAL_REPO/model/Wan2.1-Fun-V1.1-1.3B-Control"
# Physical GPU indices on your own server (four GPUs for the full experiment).
export SIM2REAL_GPUS="0,1,2,3"
# Directory containing episode_XXXXXX/{real.mp4,sim.mp4,labels.npz,meta.json,...}.
export SIM2REAL_DATA="/absolute/path/to/processed/episodes"
# Original replay output directory, containing episode_XXXXXX and shared assets/.
export SIM2REAL_SOURCE="/absolute/path/to/replay/output"
# Optional relocation of original external RGB videos (never use re-encoded real.mp4).
# export SIM2REAL_REAL_VIDEOS="/absolute/path/to/observation.images.image"
# Optional writable LPIPS/Torch cache (default: $SIM2REAL_ROOT/.cache/torch).
# export SIM2REAL_TORCH_HOME="/absolute/path/to/your/torch/cache"
